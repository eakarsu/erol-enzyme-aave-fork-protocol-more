  "private": true,
  "description": "Quarantined historical Enzyme/Aave integration reference with a paper-only safety harness",
  "main": "./build/paper/index.js",
  "types": "./build/paper/index.d.ts",
  "files": [
    "build/**/*"
  ],
  "scripts": {
    "clean": "node scripts/clean-build.js",
